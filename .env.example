# Copy to .env and set the Keycloak address for your environment.
#
# Not secrets: a public OIDC client has no client secret, and these values are
# visible in the browser. Vite reads .env at startup only.

# Must match KC_HOSTNAME on the Keycloak server.
VITE_KEYCLOAK_URL=http://192.168.56.22:8080
VITE_KEYCLOAK_REALM=simple-sso
VITE_KEYCLOAK_CLIENT_ID=simple-sso-app
