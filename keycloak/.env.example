# Copy to .env next to docker-compose.yml, then edit. .env is gitignored.

# REQUIRED. The URL your browser uses to reach Keycloak, with scheme and port.
# Use the VM's host-only address - `ip -br addr` on the VM, 192.168.56.0/24.
# Never `localhost`: inside the VM that means the VM itself.
# Must be the same value as VITE_KEYCLOAK_URL in the app's .env.
KC_HOSTNAME=http://192.168.56.22:8080

# Local demo credentials. Change them for anything that is not a throwaway VM.
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin_test_pw
POSTGRES_PASSWORD=keycloak_test_pw
